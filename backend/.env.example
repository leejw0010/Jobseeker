# 비워 두면 로컬 SQLite(jobseeker.db)를 씁니다.
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=

# true면 로그인 없이 X-User-Id 헤더(없으면 고정 dev 사용자)로 동작. 배포 시 false.
AUTH_DISABLED=true
# Supabase: Project Settings → API → JWT Secret (HS256)
SUPABASE_JWT_SECRET=

# 녹음 저장소. 비워 두면 backend/recordings/ 로컬 폴더에 저장.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=recordings

# 비워 두면 맞춤 질문은 템플릿 기반, 전사·AI 피드백은 비활성
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

CORS_ORIGINS=http://localhost:5173
