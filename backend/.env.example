# 비워 두면 로컬 SQLite(jobseeker.db)를 씁니다.
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=

# 인증은 기본으로 켜집니다. 로컬 개발에서만 true로 명시하면 X-User-Id를 믿습니다.
AUTH_DISABLED=false
# production에서는 AUTH_DISABLED=true가 시작 오류입니다.
APP_ENV=development
# hs256: 기존 JWT Secret / jwks: 프로젝트 공개 키(RS256 또는 ES256, kid 회전 지원)
SUPABASE_JWT_MODE=hs256
# 두 모드 모두 아래 SUPABASE_URL의 issuer와 authenticated audience를 검증합니다.
# Supabase: Project Settings → API → JWT Secret (HS256)
SUPABASE_JWT_SECRET=

# 녹음 저장소. 비워 두면 backend/recordings/ 로컬 폴더에 저장.
# 로컬 녹음 폴더 위치(비우면 backend/recordings/). e2e는 실행마다 임시 폴더를 넘긴다
RECORDINGS_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=recordings

# 음성 전사 제공자: local(이 서버 CPU에서 faster-whisper로 전사, 녹음을 외부로 보내지 않음, 기본)
# | openai(OpenAI 음성 인식, OPENAI_API_KEY 필요) | off(자동 전사 끔). 아래 OpenAI 키와 따로 정합니다
STT_PROVIDER=local
# 다국어 Whisper 크기(tiny·base·small·medium·large-v3 등) 또는 변환된 모델 폴더 경로. 클수록 정확하고 느림
LOCAL_STT_MODEL=base
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
# 전사에 쓸 CPU 스레드 수(비우면 min(4, 코어 수))
LOCAL_STT_CPU_THREADS=
# 1이면 더 빠르고 조금 덜 정확함
LOCAL_STT_BEAM_SIZE=5
# 모델 캐시 폴더. 비우면 ~/.cache/huggingface. 저장소 안에 두려면 backend/models(.gitignore 대상)를 쓰세요
LOCAL_STT_MODEL_DIR=
# 첫 전사 때 캐시에 모델이 없으면 Hugging Face에서 한 번 내려받음. 이후에는 네트워크 없이 캐시만 씀.
# 미리 받아 두기: cd backend && .venv/bin/python -m app.stt download
LOCAL_STT_ALLOW_DOWNLOAD=true
# 다른 전사가 도는 동안 기다리는 최대 시간(초). 넘으면 실패로 두고 원본을 남겨 다시 시도하게 함
LOCAL_STT_QUEUE_TIMEOUT_SEC=60
# 자동 전사할 최대 녹음 길이(초)
LOCAL_STT_MAX_AUDIO_SEC=900

# 비워 두면 맞춤 질문은 템플릿 기반, 답변 코칭은 기본 점검, 세션 디브리프는 비활성(OpenAI로 아무것도 보내지 않음).
# 음성 전사는 STT_PROVIDER=openai일 때만 이 키를 씀
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# STT_PROVIDER=openai일 때의 전사 모델
OPENAI_STT_MODEL=whisper-1
# 세션 디브리프 요약에 쓸 모델(temperature 0.2). 비우면 OPENAI_CHAT_MODEL. 답변 코칭·꼬리질문은 OPENAI_CHAT_MODEL
OPENAI_FEEDBACK_MODEL=
# OpenAI 호환 API 주소. 테스트·e2e에서 가짜 서버를 가리킬 때만 바꾸세요
OPENAI_BASE_URL=https://api.openai.com/v1

# 원본 녹음 보관 기간(일). 기본은 전사가 끝나면 원본을 바로 지우고,
# 전사에 실패했거나 사용자가 보관을 고른 녹음도 이 기간이 지나면 자동 삭제
AUDIO_RETENTION_DAYS=30
# 만료된 원본 녹음을 정리하는 주기(분). 앱 시작 시에도 한 번 정리
PURGE_INTERVAL_MIN=60

CORS_ORIGINS=http://localhost:5173

# Apply supabase/migrations/20261104_practice_insights.sql manually before enabling on Postgres.
# Disabled omits new ORM columns/tables, allowing legacy deployments before migration.
PRACTICE_INSIGHTS_ENABLED=false
# Optional evidence within existing coaching call; no additional model calls.
PRACTICE_COMPETENCY_EVIDENCE_ENABLED=false
